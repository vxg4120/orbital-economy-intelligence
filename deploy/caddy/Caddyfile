# Caddy reverse proxy with automatic Let's Encrypt TLS.
# {$BASE_DOMAIN} / {$ACME_EMAIL} are injected from the caddy container environment
# (set in .env). Certs auto-provision once the A records point here and 80/443 are open.

{
	email {$ACME_EMAIL}
}

# The two SPA hosts, orbital and exo; {args[0]} is the app's upstream. The app serves its built
# SPA and answers every path it does not know with index.html and a 200 (api/main.py): right for
# a deep link like /satellites/25544, wrong for everything below, so Caddy answers those first.
(spa) {
	# A scanner's /.env, /.git/config or /wp-login.php gets a real 404, not a page that reads as
	# found. No SPA route has a segment that starts with a dot or ends in .php. ACME's HTTP-01
	# path is exempt, though Caddy solves challenges before any route runs.
	@probe {
		path_regexp /\.|\.php$
		not path /.well-known/acme-challenge/*
	}
	respond @probe 404

	# Crawlers asking for robots.txt were handed the SPA shell.
	respond /robots.txt <<TXT
		User-agent: *
		Allow: /
		TXT 200

	# Vite names every bundle by its content hash (index-vraI7x54.js), so a changed file is a new
	# URL and a year of caching can never serve a stale one; index.html lives outside /assets/
	# and revalidates. A bundle that is not there (an old tab asking for the last deploy's chunk)
	# comes back as the SPA shell with a 200: that becomes the 404 it is, marked no-store,
	# because a cached copy of either would outlive a rollback that brings the name back. Only a
	# real 200 bundle is marked immutable, and the deferred set replaces any Cache-Control the
	# app sends (copy_response already copies the upstream headers; copying them again would
	# duplicate them). A 304 or an error passes through as the app sent it.
	handle /assets/* {
		reverse_proxy {args[0]} {
			@shell {
				status 200
				header Content-Type text/html*
			}
			handle_response @shell {
				header Cache-Control "no-store"
				respond 404
			}
			@bundle status 200
			handle_response @bundle {
				header >Cache-Control "public, max-age=31536000, immutable"
				copy_response
			}
		}
	}

	reverse_proxy {args[0]}
}

# Root landing page (portfolio; /live/* proxies let the page query the apps
# same-origin so its metrics are real, no CORS needed)
{$BASE_DOMAIN} {
	log {
		output file /data/access/landing.log {
			roll_size 25MiB
			roll_keep 5
		}
		format json
	}
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
	}

	handle /live/orbital {
		rewrite * /api/stats
		reverse_proxy oei-api:8600
	}
	handle /live/exo {
		rewrite * /api/stats
		reverse_proxy exo-api:8700
	}
	handle {
		root * /srv/landing
		header /fonts/* Cache-Control "public, max-age=31536000, immutable"
		file_server
	}
	# Unknown paths get the site's own 404 page instead of Caddy's bare status line.
	# file_server keeps the error's status code when it runs inside handle_errors, so
	# the response is still a real 404, just with a body. Only 404 is styled: a 502
	# from a proxied /live/* upstream keeps its plain shape, which the page's own
	# fetch treats as "not live" and falls back on the cached tile values.
	handle_errors {
		@notfound expression {err.status_code} == 404
		handle @notfound {
			root * /srv/landing
			rewrite * /404.html
			file_server
		}
	}
}

# www -> apex (canonical)
www.{$BASE_DOMAIN} {
	redir https://{$BASE_DOMAIN}{uri} permanent
}

# Satellite platform — Orbital Economy Intelligence
orbital.{$BASE_DOMAIN} {
	log {
		output file /data/access/orbital.log {
			roll_size 25MiB
			roll_keep 5
		}
		format json
	}
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		# geolocation=(self): the Reachability view asks the browser for the observer's
		# position to sweep what is overhead. An empty list, geolocation=(), disables the
		# feature outright, so Chrome never prompts and getCurrentPosition fails instantly
		# with PERMISSION_DENIED. Camera and mic stay closed; nothing here uses them.
		Permissions-Policy "camera=(), microphone=(), geolocation=(self)"
	}

	import spa oei-api:8600
}

# ExoDossier — exoplanet candidate vetting
exo.{$BASE_DOMAIN} {
	log {
		output file /data/access/exo.log {
			roll_size 25MiB
			roll_keep 5
		}
		format json
	}
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
	}

	import spa exo-api:8700
}
