# Copy to .env and fill in.  NEVER commit .env (see .gitignore).

# --- Postgres (single Timescale cluster holding both oei + exo) ---
# Long random string.  Generate one with:  openssl rand -hex 24
POSTGRES_PASSWORD=

# --- Domain + TLS ---
# You own BASE_DOMAIN; the apps are served at:
#   https://orbital.BASE_DOMAIN   (satellite)
#   https://exo.BASE_DOMAIN       (exodossier)
# Caddy provisions Let's Encrypt certs for both. ACME_EMAIL gets expiry notices.
BASE_DOMAIN=example.com
ACME_EMAIL=you@example.com

# --- Satellite gold-verdict write endpoint (optional) ---
# Guards the one write route (X-Review-Token). Random string; leave blank if unused.
REVIEW_TOKEN=

# --- Space-Track credentials (optional) ---
# Used by the nightly's oei_spacetrack step (scripts/spacetrack_topup.py): once a day it
# pulls the new gp_history element sets for the benchmark fleet into gp_elements and the
# last 30 days of actual decays into raw_spacetrack_decay (docs/specs/spacetrack-topup.md).
# Also used by a manual scripts/backfill_gp_history.py run. Blank: that step logs one line
# and exits 0, and the CelesTrak pulls (current element sets) still run.
# Free account: https://www.space-track.org/auth/createAccount
SPACETRACK_IDENTITY=
SPACETRACK_PASSWORD=

# --- Nightly failure alerts (optional) ---
# When a nightly step or gate fails, its "!!" lines are POSTed here as plain text. An ntfy.sh
# topic URL works as is (pick a long random topic name, since anyone who knows it can read it),
# with the ntfy app subscribed on your phone. Unset, failures stay in deploy/refresh.log only.
ALERT_URL=
