      "date_last_update": "2025-06-16",
      "satellite_name": "SPACEX GEN2 (S3069)",
      "itu_name": "SpaceX GEN2 (S3069)",
      "orbit_location": "NGSO",
      "description": "SpaceX seeks modification of its Gen2 authorization to add 1.5/1.6 and 1.6/2.4 GHz MSS operations in the United States.",
      "applicant_name": "Space Exploration Holdings, LLC",
      "applicant_frn": "0025985060",
      "applicant_slug": "spx",
      "documents_n": 10,
      "note_summary": "SpaceX asks to bolt a mobile-satellite service system onto the Gen2 constellation in the 1.5/1.6 GHz and 1.6/2.4 GHz bands, which is the spectrum play behind expanding direct-to-device service beyond the T-Mobile PCS band. The application revives a request the Space Bureau previously dismissed without prejudice, argues the dismissal was made in error, and picks a direct sharing fight with Globalstar in the Big LEO band, contending the incumbent's legacy CDMA systems use only 0.3 percent of the spectrum they hold.",
      "note_key_points": [
        "Bands sought: 1525-1559 MHz, 1626.5-1660.5 MHz, 1610-1617.775 MHz, 2483.5-2500 MHz",
        "Modification of the existing Gen2 NGSO authorization (call sign S3069), not a new system",
        "Frames direct-to-device MSS as a 6G-era strategic priority for consumers, critical industries and first responders",
        "Explicitly targets Globalstar's exclusivity in the 1.6/2.4 GHz band, citing 0.3 percent utilization of legacy capacity"
      ],
      "note_source_doc": "Narrative.pdf",
      "note_source_pages": "Summary, pp. i-ii",
      "spec_orbit_type": "NGSO",
      "spec_network_name": "Flock",
      "spec_total_satellites": 200,
      "spec_planes_n": 1,
      "spec_alt_min_km": 500,
